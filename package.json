{
  "name": "lightweight-epub-merge-tool-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "check:ts": "tsc -p tsconfig.json --noEmit",
    "verify:ts": "npm run check:ts",
    "dev:web": "vite --config web/vite.config.ts --host 127.0.0.1",
    "build:web": "vite build --config web/vite.config.ts",
    "verify:web": "npm run build:web",
    "verify": "npm run verify:ts && npm run verify:web",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@zip.js/zip.js": "^2.24.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-xml-parser": "^5.8.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
