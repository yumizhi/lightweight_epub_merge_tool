{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "react",
      "react-dom"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../ts/src/**/*.ts",
    "vite.config.ts"
  ]
}
